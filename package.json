{
  "name": "pdf-viewer-for-vs-code",
  "displayName": "PDF Viewer - VS Code Extension",
  "description": "Extension that allows to visualize PDF files inside VS Code.",
  "version": "1.0.6",
  "publisher": "Pirespt",
  "icon": "assets/images/PDFViewer.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tiagop/pdf-code-extension"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "pdfViewer.preview",
        "displayName": "PDF Viewer",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.109.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "copy-webpack-plugin": "14.0.0",
    "eslint": "10.13.0",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "webpack": "5.112.2",
    "webpack-cli": "7.2.3"
  }
}
